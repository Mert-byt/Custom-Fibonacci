//@version=6
indicator("Volume Profile by SlyTrader", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000, behind_chart = true)

// ═══════════════════════════════ INPUTS ═══════════════════════════════
grpCalc = "Calculation"
// Auto Lookback system based on chart timeframe
useAutoLB   = input.bool(true, "Auto Lookback (Timeframe Based)", group = grpCalc, tooltip = "Automatically adjusts the lookback bars based on the chart timeframe.\n1m-5m: 50\n15m-1H: 150\n1D: 200\n1W: 300\n1M: 120")
manualLB    = input.int(200, "Manual Lookback Bars", minval = 10, maxval = 5000, group = grpCalc, tooltip = "Used if Auto Lookback is disabled.")
rows        = input.int(24,  "Number of Rows",  minval = 5, maxval = 100,  group = grpCalc)
vaPercent   = input.float(70, "Value Area %",   minval = 1,  maxval = 100,  group = grpCalc) / 100.0

grpProf = "Profile Appearance"
profileWidth = input.int(80, "Max Profile Width (bars)", minval = 10, maxval = 450, group = grpProf)

grpColor = "Colors & Lines"
upColor   = input.color(color.new(#26a69a, 55), "Up Volume",   group = grpColor)
downColor = input.color(color.new(#ef5350, 55), "Down Volume", group = grpColor)
showPOC   = input.bool(true,  "Show POC",        group = grpColor)
pocColor  = input.color(color.new(#ff5d00, 0),   "POC Color",  group = grpColor) 
showVA    = input.bool(true,  "Show Value Area", group = grpColor)
vaColor   = input.color(color.new(#2962ff, 0),   "VA Color",   group = grpColor)
lblShow   = input.bool(true,  "Show Labels", group = grpColor)
lblSize   = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpColor)
lblOffset = input.int(2, "Label Bar Offset", minval = 0, maxval = 20, group = grpColor)

lblSizeVal = lblSize == "Tiny" ? size.tiny : lblSize == "Small" ? size.small : lblSize == "Normal" ? size.normal : size.large

// ═══════════════════════ AUTO LOOKBACK LOGIC ═══════════════════════
int autoLB = 200 // Default fallback
if timeframe.isintraday
    autoLB := timeframe.in_seconds() <= 300 ? 50 : 150 // <= 5m is 50, > 5m (15m, 30m, 1H) is 150
else if timeframe.isdaily
    autoLB := 200
else if timeframe.isweekly
    autoLB := 300
else if timeframe.ismonthly
    autoLB := 120

int lookback = useAutoLB ? autoLB : manualLB

// ═══════════════════════ GLOBAL CALCULATIONS ═══════════════════════
float rangeHigh = ta.highest(high, lookback)
float rangeLow  = ta.lowest(low,  lookback)

// ═══════════════════════ DRAWING STORAGE ═══════════════════════
var array<box>   boxUp   = array.new<box>()
var array<box>   boxDn   = array.new<box>()
var array<line>  vaLines = array.new<line>()
var array<label> vaLbls  = array.new<label>()

wipe() =>
    if array.size(boxUp) > 0
        for b in boxUp
            box.delete(b)
    if array.size(boxDn) > 0
        for b in boxDn
            box.delete(b)
    if array.size(vaLines) > 0
        for l in vaLines
            line.delete(l)
    if array.size(vaLbls) > 0
        for lb in vaLbls
            label.delete(lb)
    array.clear(boxUp)
    array.clear(boxDn)
    array.clear(vaLines)
    array.clear(vaLbls)

// ═══════════════════════ MAIN CALCULATION ═══════════════════════
if barstate.islast
    wipe()
    
    if rangeHigh > rangeLow
        float rowH = (rangeHigh - rangeLow) / rows
        float[] upVol = array.new_float(rows, 0.0)
        float[] dnVol = array.new_float(rows, 0.0)

        for i = 0 to lookback - 1
            float bH = high[i], float bL = low[i], float bVol = volume[i]
            float bRange = math.max(bH - bL, syminfo.mintick)
            bool isUp = close[i] >= open[i]
            
            int idxLow  = math.max(0, math.min(rows - 1, math.floor((bL - rangeLow) / rowH)))
            int idxHigh = math.max(0, math.min(rows - 1, int(math.ceil((bH - rangeLow) / rowH)) - 1))
            
            for r = idxLow to idxHigh
                float rHigh = rangeLow + (r + 1) * rowH
                float rLow  = rangeLow + r * rowH
                float overlap = math.min(bH, rHigh) - math.max(bL, rLow)
                if overlap > 0
                    float volAdd = bVol * (overlap / bRange)
                    array.set(isUp ? upVol : dnVol, r, array.get(isUp ? upVol : dnVol, r) + volAdd)

        float maxVol = 0.0, float grandTot = 0.0
        int pocIdx = 0
        float[] totVol = array.new_float(rows, 0.0)
        
        for r = 0 to rows - 1
            float t = array.get(upVol, r) + array.get(dnVol, r)
            array.set(totVol, r, t)
            grandTot += t
            if t > maxVol
                maxVol := t
                pocIdx := r

        float vaSum = array.get(totVol, pocIdx)
        int upPtr = pocIdx, int dnPtr = pocIdx
        while vaSum < grandTot * vaPercent and (upPtr < rows - 1 or dnPtr > 0)
            float va = upPtr < rows - 1 ? array.get(totVol, upPtr + 1) : -1.0
            float vb = dnPtr > 0 ? array.get(totVol, dnPtr - 1) : -1.0
            if va >= vb
                upPtr += 1, vaSum += va
            else
                dnPtr -= 1, vaSum += vb

        // The flat back of the profile is anchored exactly at the FIRST bar of the lookback period
        int anchor = math.max(0, bar_index - lookback + 1)
        
        if maxVol > 0
            // Draw Profile Boxes
            // Profile starts at the anchor (first bar) and extends RIGHT
            // Up (Green) is on the left (flat back), Down (Red) is on the right.
            for r = 0 to rows - 1
                float rLow = rangeLow + r * rowH, float rHigh = rLow + rowH
                float uV = array.get(upVol, r), float dV = array.get(dnVol, r), float tV = uV + dV
                if tV > 0
                    int wTot = math.max(1, int(math.round(tV / maxVol * profileWidth)))
                    int wUp = int(math.round(wTot * uV / tV)), int wDn = wTot - wUp
                    
                    if wUp > 0
                        array.push(boxUp, box.new(anchor, rHigh, anchor + wUp, rLow, xloc = xloc.bar_index, border_width = 0, bgcolor = upColor))
                    if wDn > 0
                        array.push(boxDn, box.new(anchor + wUp, rHigh, anchor + wUp + wDn, rLow, xloc = xloc.bar_index, border_width = 0, bgcolor = downColor))

            // Lines: Start from the anchor (first bar) and extend 2x profileWidth to the RIGHT
            int lineStartX = anchor
            int lineEndX   = anchor + profileWidth * 2
            
            int lblX = lineEndX + lblOffset
            
            if showPOC
                float pocP = rangeLow + pocIdx * rowH + rowH / 2
                array.push(vaLines, line.new(lineStartX, pocP, lineEndX, pocP, xloc = xloc.bar_index, color = pocColor, width = 2, style = line.style_solid))
                if lblShow
                    array.push(vaLbls, label.new(lblX, pocP, "POC " + str.tostring(pocP, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.gray, textcolor = color.black, size = lblSizeVal))
            
            if showVA
                float vah = rangeLow + (upPtr + 1) * rowH, float val = rangeLow + dnPtr * rowH
                array.push(vaLines, line.new(lineStartX, vah, lineEndX, vah, xloc = xloc.bar_index, color = vaColor, width = 1, style = line.style_dashed))
                array.push(vaLines, line.new(lineStartX, val, lineEndX, val, xloc = xloc.bar_index, color = vaColor, width = 1, style = line.style_dashed))
                if lblShow
                    array.push(vaLbls, label.new(lblX, vah, "VAH " + str.tostring(vah, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.gray, textcolor = color.black, size = lblSizeVal))
                    array.push(vaLbls, label.new(lblX, val, "VAL " + str.tostring(val, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.gray, textcolor = color.black, size = lblSizeVal))
